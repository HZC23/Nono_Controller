<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.hzc.nonocontroller.viewmodel.MainViewModel" />
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <!-- Left Section: D-Pad -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dpad_section"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/telemetry_section"
            app:layout_constraintHorizontal_weight="1">

            <ImageButton
                android:id="@+id/button_stop_center"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:onClick="@{() -> viewModel.onStopButtonClicked()}"
                android:background="@drawable/stop_button_background"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageButton
                android:id="@+id/button_up"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_baseline_keyboard_arrow_up_24"
                android:background="@drawable/dpad_button_background"
                app:layout_constraintBottom_toTopOf="@+id/button_stop_center"
                app:layout_constraintStart_toStartOf="@+id/button_stop_center"
                app:layout_constraintEnd_toEndOf="@+id/button_stop_center"
                android:layout_marginBottom="8dp"/>

            <ImageButton
                android:id="@+id/button_down"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
                android:background="@drawable/dpad_button_background"
                app:layout_constraintTop_toBottomOf="@+id/button_stop_center"
                app:layout_constraintStart_toStartOf="@+id/button_stop_center"
                app:layout_constraintEnd_toEndOf="@+id/button_stop_center"
                android:layout_marginTop="8dp"/>

            <ImageButton
                android:id="@+id/button_left"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_baseline_keyboard_arrow_left_24"
                android:background="@drawable/dpad_button_background"
                app:layout_constraintEnd_toStartOf="@+id/button_stop_center"
                app:layout_constraintTop_toTopOf="@+id/button_stop_center"
                app:layout_constraintBottom_toBottomOf="@+id/button_stop_center"
                android:layout_marginEnd="8dp"/>

            <ImageButton
                android:id="@+id/button_right"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                android:background="@drawable/dpad_button_background"
                app:layout_constraintStart_toEndOf="@+id/button_stop_center"
                app:layout_constraintTop_toTopOf="@+id/button_stop_center"
                app:layout_constraintBottom_toBottomOf="@+id/button_stop_center"
                android:layout_marginStart="8dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Center Section: Telemetry -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/telemetry_section"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/dpad_section"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/actions_section"
            app:layout_constraintHorizontal_weight="1"
            android:layout_margin="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Télémétrie"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:layout_marginBottom="8dp"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="1">

                    <TextView
                        android:id="@+id/telemetry_state_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Etat: IDLE"
                        android:textAppearance="?attr/textAppearanceBody1"/>

                    <TextView
                        android:id="@+id/telemetry_heading_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Cap: 90°"
                        android:textAppearance="?attr/textAppearanceBody1"/>

                    <TextView
                        android:id="@+id/telemetry_distance_us_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Distance US: 100 cm"
                        android:textAppearance="?attr/textAppearanceBody1"/>

                    <TextView
                        android:id="@+id/telemetry_distance_laser_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Distance Laser: 200 mm"
                        android:textAppearance="?attr/textAppearanceBody1"/>

                    <TextView
                        android:id="@+id/telemetry_battery_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Batterie: 75%"
                        android:textAppearance="?attr/textAppearanceBody1"/>

                    <TextView
                        android:id="@+id/telemetry_speed_target_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Vitesse Cible: 200"
                        android:textAppearance="?attr/textAppearanceBody1"/>

                </GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Right Section: Actions -->
        <!-- Right Section: Actions -->
        <LinearLayout
            android:id="@+id/actions_section"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/telemetry_section"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/scan_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Scan"/>
                <Button
                    android:id="@+id/settings_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."/>
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">

                <ImageButton
                    android:id="@+id/smart_avoidance_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_baseline_explore_24"
                    app:tint="?attr/colorPrimary"
                    android:onClick="@{() -> viewModel.onSmartAvoidanceClicked()}"/>

                <ImageButton
                    android:id="@+id/goto_heading_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_baseline_center_focus_strong_24"
                    app:tint="?attr/colorPrimary"
                    />

                <ImageButton
                    android:id="@+id/sentry_mode_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_baseline_visibility_24"
                    app:tint="?attr/colorPrimary"
                    android:onClick="@{() -> viewModel.onSentryModeClicked()}"/>

                <ImageButton
                    android:id="@+id/calibrate_compass_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_baseline_settings_24"
                    app:tint="?attr/colorPrimary"
                    android:onClick="@{() -> viewModel.onCalibrateCompassClicked()}"/>

            </GridLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/light_switch_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Phares"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:onCheckedChanged="@{(_, isChecked) -> viewModel.onLightSwitched(isChecked)}"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vitesse"
                android:textAppearance="?attr/textAppearanceSubtitle1"/>

            <SeekBar
                android:id="@+id/speed_slider_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="@{viewModel.speed}"
                app:onSeekBarChangeListener="@{viewModel.onSpeedChanged}"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/main_lcd_message_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Message LCD"/>
                <Button
                    android:id="@+id/main_send_lcd_message_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OK"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
