<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.hzc.nonocontroller.viewmodel.MainViewModel" />
        <import type="android.view.View"/>
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <!-- Joystick/D-Pad Controls -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                tools:padding="20dp">

                <Button
                    android:id="@+id/button_stop_center"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:text="STOP"
                    android:singleLine="true"
                    android:onClick="@{() -> viewModel.onStopButtonClicked()}"
                    app:backgroundTint="@color/design_default_color_error"
                    android:textColor="@android:color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageButton
                    android:id="@+id/button_up"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_arrow_up"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toTopOf="@id/button_stop_center"
                    app:layout_constraintStart_toStartOf="@id/button_stop_center"
                    app:layout_constraintEnd_toEndOf="@id/button_stop_center" />

                <ImageButton
                    android:id="@+id/button_down"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_arrow_down"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/button_stop_center"
                    app:layout_constraintStart_toStartOf="@id/button_stop_center"
                    app:layout_constraintEnd_toEndOf="@id/button_stop_center" />

                <ImageButton
                    android:id="@+id/button_left"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_arrow_left"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toStartOf="@id/button_stop_center"
                    app:layout_constraintTop_toTopOf="@id/button_stop_center"
                    app:layout_constraintBottom_toBottomOf="@id/button_stop_center" />

                <ImageButton
                    android:id="@+id/button_right"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_arrow_right"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@id/button_stop_center"
                    app:layout_constraintTop_toTopOf="@id/button_stop_center"
                    app:layout_constraintBottom_toBottomOf="@id/button_stop_center" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- LCD Message Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lcd_message_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/main_lcd_message_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Message LCD"/>
                    <Button
                        android:id="@+id/main_send_lcd_message_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Envoyer"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Accessories Card (Speed, Headlights) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vitesse"
                        android:textAppearance="?attr/textAppearanceSubtitle1"/>

                    <SeekBar
                        android:id="@+id/speed_slider_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="255"
                        android:progress="@{viewModel.speed}"
                        app:onSeekBarChangeListener="@{viewModel.onSpeedChanged}"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/light_switch_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Phares"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:onCheckedChanged="@{(_, isChecked) -> viewModel.onLightSwitched(isChecked)}"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</layout>